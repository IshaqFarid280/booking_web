{
    "version": 2,
    "functions": {
      "api/index.php": {
        "runtime": "vercel-php@0.6.0",
        "memory": 1024,
        "phpVersion": "8.2"
      }
    },
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/api/index.php"
      }
    ],
    "env": {
      "APP_ENV": "production",
      "APP_DEBUG": "false",
      "APP_URL": "https://booking-web-flax.vercel.app",
      "APP_NAME": "SharanForest",
      "APP_KEY": "base64:your-app-key",
      "LOG_CHANNEL": "stderr",
      "VIEW_COMPILED_PATH": "/tmp/views",
      "SESSION_DRIVER": "array",
      "CACHE_DRIVER": "array",
      "QUEUE_CONNECTION": "sync",
      "SERVER_SOFTWARE": "Vercel"
    }
  }
  